{
  "name": "nexus-dom",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental DOM rendering models for nexus-state",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --config example/vite.config.ts",
    "example:build": "vite build --config example/vite.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "vitest bench --run",
    "benchmark:browser": "node benchmarks/browser/run.mjs",
    "benchmark:browser:dev": "vite --config benchmarks/browser/vite.config.ts",
    "benchmark:bundle": "node benchmarks/bundle/run.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run example:build"
  },
  "dependencies": {
    "nexus-state": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.65.1",
    "typescript": "^5.6.2",
    "vite": "^8.0.0",
    "vitest": "4.1.12"
  }
}
