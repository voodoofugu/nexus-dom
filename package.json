{
  "name": "nexus-dom",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental DOM rendering models for nexus-state",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/types/jsx-runtime.d.ts",
      "import": "./dist/esm/jsx-runtime.js",
      "require": "./dist/cjs/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/types/jsx-dev-runtime.d.ts",
      "import": "./dist/esm/jsx-dev-runtime.js",
      "require": "./dist/cjs/jsx-dev-runtime.js"
    },
    "./server": {
      "types": "./dist/types/server.d.ts",
      "import": "./dist/esm/server.js",
      "require": "./dist/cjs/server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --config example/vite.config.ts",
    "example:build": "vite build --config example/vite.config.ts",
    "build:types": "tsc -p tsconfig.types.json",
    "build": "npm run typecheck && rollup -c rollup.config.mjs && npm run build:types && node scripts/prepare-dist.mjs",
    "build:dev": "npm run typecheck && NEXUS_DOM_BUILD=development rollup -c rollup.config.mjs && npm run build:types && node scripts/prepare-dist.mjs",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "smoke:dogfood": "npm run example:build && node scripts/smoke-dogfood.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "vitest bench --run",
    "benchmark:browser": "node benchmarks/browser/run.mjs",
    "benchmark:browser:dev": "vite --config benchmarks/browser/vite.config.ts",
    "benchmark:compare": "node benchmarks/compare/run.mjs",
    "benchmark:compare:mobile": "NEXUS_DOM_CPU_THROTTLE=4 NEXUS_DOM_SKIP_MEMORY=1 node benchmarks/compare/run.mjs",
    "benchmark:compare:firefox": "NEXUS_DOM_BROWSER=firefox node benchmarks/compare/run.mjs",
    "benchmark:compare:webkit": "NEXUS_DOM_BROWSER=webkit node benchmarks/compare/run.mjs",
    "benchmark:compare:matrix": "npm run benchmark:compare && npm run benchmark:compare:firefox && npm run benchmark:compare:webkit",
    "benchmark:heap": "node benchmarks/heap/run.mjs",
    "benchmark:density": "node benchmarks/density/run.mjs",
    "benchmark:bundle": "node benchmarks/bundle/run.mjs",
    "check": "npm run test && npm run build && npm run smoke:dist && npm run example:build"
  },
  "dependencies": {
    "nexus-state": "^4.0.2"
  },
  "devDependencies": {
    "@preact/signals": "2.11.4",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@solidjs/web": "2.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.65.1",
    "preact": "11.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rollup": "^4.21.3",
    "rollup-plugin-delete": "^3.0.1",
    "solid-js": "2.0.3",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2",
    "vite": "^8.0.0",
    "vitest": "4.1.12"
  }
}
